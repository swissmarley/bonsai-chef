# Copy to .env for local development (`npm run setup` does this and fills in the secrets).
# On Netlify, set the same variables under Site configuration → Environment variables.

# Neon connection string (Netlify DB sets NETLIFY_DATABASE_URL automatically, which also works).
# Local development uses the embedded Postgres started by `npm run dev:db`.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/bonsai_chef

# At least 32 random characters, used to hash login codes.
AUTH_SECRET=

# Resend (https://resend.com) — sends login codes and reminder e-mails.
# Without a key, local development prints e-mails to the terminal instead.
RESEND_API_KEY=
EMAIL_FROM=Bonsai Chef <onboarding@resend.dev>

# Optional: comma-separated list of e-mails allowed to log in. Empty = anyone can create an account.
ALLOWED_EMAILS=

# Where messages from the contact form of the Info page arrive (never shown in the app).
# Without it, local development prints them to the terminal.
FEEDBACK_EMAIL=

# Web Push (VAPID) keys for reminder notifications — generated by `npm run setup`.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# mailto: or https: contact, required by Apple/Google push services.
VAPID_SUBJECT=

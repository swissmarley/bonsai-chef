{
  "name": "bonsai-chef-pwa",
  "private": true,
  "version": "2.0.0",
  "description": "Bonsai Chef — il diario per la cura dei tuoi bonsai (PWA)",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "setup": "node scripts/setup-env.mjs",
    "dev": "npx -y netlify-cli@27 dev",
    "dev:db": "node scripts/dev-db.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "db:rehearse": "node scripts/rehearse-migrations.mjs",
    "build": "npm run typecheck && npm test && vite build && node scripts/migrate.mjs --if-configured",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p src/tsconfig.sw.json --noEmit && tsc -p netlify/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:db": "vitest run --config vitest.db.config.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@netlify/blobs": "^11.1.1",
    "@tanstack/react-query": "^5.104.0",
    "lucide-react": "^1.49.0",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "web-push": "^3.6.7",
    "workbox-expiration": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@netlify/functions": "^6.0.0",
    "@types/node": "^22.20.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.1.1",
    "embedded-postgres": "^17.10.0-beta.17",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.2",
    "workbox-window": "^7.4.1"
  }
}
